# OS / editor
.DS_Store

# Agent session-local surfaces — never committed. Agent memory lives at user level.
.claude/agent-memory/*
.claude/agent-memory-local/
.claude/worktrees/
CLAUDE.local.md

# Codex session-local surfaces — same class as .claude/worktrees/
.codex/

# Local session capture (never committed, per global convention)
.devlog/
.screenshots/
.traces/

# Planning notes that local workflows write here: never tracked (ONL-2393).
# A doc that governs code lives beside that code, not here.
docs/

# Dependencies & build output
node_modules/
dist/
out/
# Anchored: the cut lands at the repo root only, and a bare `release/` also
# swallows any directory of that name at any depth (it once ate a nested directory named `release`).
/release/
.turbo/

*.tsbuildinfo

# Test artifacts
tests/e2e/.report/
tests/e2e/.artifacts/

# Env — secrets never enter git
.env
.env.*
!.env.example

# Local runtime viewer, never committed
apps/studio/.runtime-views/

# Generated at cut time by scripts/cut-dmg.ts (retina merge of the two brand
# jpgs) — shipped inside the app so the DMG window's background alias can
# point into the bundle instead of at a stray root file (ONL-1947).
apps/studio/build/dmg-background.tiff

# astryx theme build without --out drops its output beside the source; the canonical artifact lives in src/renderer/src/theme/
apps/studio/src/theme/studio.css
apps/studio/src/theme/studio.js
apps/studio/src/theme/studio.d.ts
apps/studio/src/theme/studio.variants.d.ts

# A one-off script and the roots it launches the app on: state, worktrees, Chromium profiles, logs (ONL-2400).
.scratch/
*.scratch.*

# local design-register scratch
.design-register/

# JUnit reports from test:report
.test-results/
